# Test environment — copy this file to .env.test and fill in your values.
# .env.test is gitignored and never committed.
#
# You need a SEPARATE Discord application for the test bot:
#   1. Go to discord.com/developers/applications → New Application
#   2. Add a Bot, copy its Token → STOCKPILER_TOKEN
#   3. Copy the Application ID → STOCKPILER_CLIENT_ID
#   4. Create a personal/test Discord server, copy its ID → STOCKPILER_GUILD_ID
#      (Right-click the server icon → Copy Server ID, with Developer Mode on)
#   5. Invite the test bot to that server with the OAuth2 URL generator
#      (Bot scope + Administrator permission)

STOCKPILER_TOKEN=your_test_bot_token_here
STOCKPILER_CLIENT_ID=your_test_client_id_here
STOCKPILER_GUILD_ID=your_test_guild_id_here

# Separate database — keeps test data out of production
MONGODB_DB=stockpiler_test
# MONGODB_URI=mongodb://localhost:27017   # default, uncomment to override

NODE_ENV=development
STOCKPILER_MULTI_SERVER=false
APP_PORT=3001
